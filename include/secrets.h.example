#pragma once
// Example secrets.h file.

// Your punch endpoint: Supabase > Edge Functions > punch
#define FUNCTION_URL "xyz"

// The token shown ONCE when you registered the reader on the website (Readers tab).
#define DEVICE_TOKEN "xyz"

// Name and password of the WiFi setup hotspot the reader creates when it has no WiFi.
// Password must be at least 8 characters.
#define PORTAL_AP_NAME "attendance_setup"
#define PORTAL_AP_PASS "easypass123"

// POSIX timezone string (only used for readable log times; punches are sent in UTC).
// Sydney with daylight saving:
#define TZ_INFO "AEST-10AEDT,M10.1.0,M4.1.0/3"

// Uncomment ONLY for first-time debugging if HTTPS certificate checks fail.
// This turns certificate checking OFF, which makes the link easy to impersonate.
// #define TLS_INSECURE_FOR_TESTING
